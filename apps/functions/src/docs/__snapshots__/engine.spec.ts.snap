"<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><w:body><w:p><w:pPr><w:pStyle w:val="Title"/></w:pPr><w:r><w:t xml:space="preserve">Costs disclosure</w:t></w:r></w:p><w:p><w:r><w:rPr><w:i/><w:highlight w:val="yellow"/></w:rPr><w:t xml:space="preserve">Add your firm’s statement of the client’s rights under “Your rights” before this is given to a client, then delete this note.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Client: </w:t></w:r><w:r><w:t xml:space="preserve">Catherine Doyle</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Matter: </w:t></w:r><w:r><w:t xml:space="preserve">HV-2026-0001  Estate of Margaret Doyle</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Date: </w:t></w:r><w:r><w:t xml:space="preserve">6 October 2026</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">How we will charge</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Fee arrangement: </w:t></w:r><w:r><w:t xml:space="preserve">Fixed fee</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Fixed fee: </w:t></w:r><w:r><w:t xml:space="preserve">$4,400.00</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Estimate of total legal costs</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">Our current estimate is $4,000.00 to $6,000.00.</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">We will tell you in writing if this estimate changes significantly.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Your rights</w:t></w:r></w:p><w:p><w:r><w:rPr><w:highlight w:val="yellow"/></w:rPr><w:t xml:space="preserve">[Your firm’s statement of the client’s rights goes here.]</w:t></w:r></w:p><w:p></w:p><w:p><w:pPr><w:pStyle w:val="NoSpacing"/><w:keepNext/></w:pPr><w:r><w:t xml:space="preserve">Jordan Price</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="NoSpacing"/><w:keepNext/></w:pPr><w:r><w:t xml:space="preserve">Senior Associate</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="NoSpacing"/></w:pPr><w:r><w:t xml:space="preserve">Harbour &amp; Vine Legal</w:t></w:r></w:p><w:sectPr><w:headerReference w:type="default" r:id="rId10"/><w:footerReference w:type="default" r:id="rId11"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1701" w:right="1134" w:bottom="1418" w:left="1134" w:header="567" w:footer="567" w:gutter="0"/></w:sectPr></w:body></w:document>"
`;

