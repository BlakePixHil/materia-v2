rules_version = '2';

// Materia Firestore rules (FND-14). Default deny; tenancy from custom claims {orgId, role}
// (ADR-005); clients read directly and update whitelisted fields directly (ADR-006). Creates go
// through callables (Admin SDK, which bypasses these rules) and hard deletes are never allowed.
//
// Extending: add a `match` block next to its siblings, gate it with `can(orgId, '<action>')` from
// the PERMISSIONS matrix, and allow updates with `clientUpdate(fields<Entity>())`. The role lists
// and field whitelists at the bottom are generated from libs/domain
// (`pnpm materia-scripts rules-sync`), and the rules tests fail if a collection has no tests.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity and tenancy ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function claimOrg() {
      return request.auth.token.orgId;
    }
    function claimRole() {
      return request.auth.token.role;
    }
    // The claim names the org, and the member document must still be active: a suspended or removed
    // member loses access on their next request, without waiting for their token to refresh (FND-17,
    // ADR-021). Rules cache the get() within a request, so it costs one read per request.
    function memberOf(orgId) {
      return isSignedIn() && claimOrg() == orgId
        && get(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid())).data.status == 'active';
    }
    // The org's security policy accepts this sign-in (SEC-04), as the callables check it
    // (apps/functions/src/core/sessions.ts):
    // - not from before a "sign out everywhere" (the member's `sessionsValidAfter`);
    // - no older than the org's session length (`security.maxSessionDays`, 14 by default);
    // - with a second factor once the org requires MFA and the grace period is over.
    // One more cached get() (the org document) per request.
    function sessionOk(orgId) {
      let member = get(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid())).data;
      let security = get(/databases/$(database)/documents/orgs/$(orgId)).data.get('security', {});
      let signedInAt = request.auth.token.get('auth_time', 0) * 1000;
      return signedInAt >= member.get('sessionsValidAfter', timestamp.value(0)).toMillis()
        && request.time.toMillis() - signedInAt <= security.get('maxSessionDays', 14) * 86400000
        && (security.get('mfaRequired', false) == false
          || request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null
          || request.time < security.get('mfaEnforceAfter', timestamp.value(0)));
    }
    function inOrg(orgId) {
      return memberOf(orgId) && sessionOk(orgId);
    }
    function hasRole(orgId, roles) {
      return inOrg(orgId) && claimRole() in roles;
    }
    function can(orgId, action) {
      return hasRole(orgId, perm(action));
    }
    // Kept at sensitive paths for clarity; can() and inOrg() already check the member document and
    // the session. Not inOrg() again: rules evaluate at most 1000 expressions per request, and
    // sessionOk() isn't cached like get() is.
    function isActiveMember(orgId) {
      return memberOf(orgId);
    }
    function canViewPrivileged(orgId) {
      return can(orgId, 'privileged.view');
    }
    // Privileged documents are readable only by roles with privileged.view (never readonly).
    // No get() default here: in a list query, `data.get(field, default)` on a field the query does
    // not constrain evaluates to the default, which would let any query through. Comparing the
    // field itself makes a query prove it (where('privileged', '==', false)). Every entity with a
    // privileged flag stores it (the schemas default it to false).
    function visible(orgId, data) {
      return data.privileged == false || canViewPrivileged(orgId);
    }

    // ---------- writes ----------
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function unchanged(fields) {
      return !changedKeys().hasAny(fields);
    }
    function onlyChanged(fields) {
      return changedKeys().hasOnly(fields);
    }
    function validMeta() {
      return request.resource.data.updatedBy == uid() && request.resource.data.updatedAt == request.time;
    }
    // An update that touches only whitelisted fields (plus updatedAt/updatedBy) and stamps meta.
    function clientUpdate(fields) {
      return onlyChanged(fields.concat(['updatedAt', 'updatedBy'])) && validMeta();
    }
    // Soft delete (or restore): only the delete fields and meta change.
    function softDelete() {
      return onlyChanged(['deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && validMeta()
        && (
          (request.resource.data.deletedAt == request.time && request.resource.data.deletedBy == uid())
          || (request.resource.data.get('deletedAt', null) == null && request.resource.data.get('deletedBy', null) == null)
        );
    }
    // An update to records with these privileged flags (the record's, and its matter's): it sees
    // them all (visible()), and changing the flag needs privileged.view. One canViewPrivileged()
    // rather than one per record: rules evaluate at most 1000 expressions per request.
    function visibleAndFlagOk(orgId, flags) {
      return flags.toSet().hasOnly([false]) && unchanged(['privileged']) || canViewPrivileged(orgId);
    }
    // Soft delete only (no client restore): the document is live and the caller stamps the delete.
    function softDeleteOnly() {
      return resource.data.get('deletedAt', null) == null
        && onlyChanged(['deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && validMeta()
        && request.resource.data.deletedAt == request.time
        && request.resource.data.deletedBy == uid();
    }
    // Standard rule for org records: update whitelisted fields, or soft delete.
    function editable(orgId, action, fields) {
      return can(orgId, action) && (clientUpdate(fields) || softDelete());
    }

    // ---------- tasks (CORE-08) ----------
    // Fields a client may write when creating a task: `MatterTaskCreateInput` in libs/domain (the
    // rules tests check the two agree), plus the meta fields.
    function taskCreateFields() {
      return ['title', 'descriptionMd', 'status', 'priority', 'assigneeUid', 'dueDate', 'deadlineId', 'group', 'checklist', 'order', 'source', 'orgId', 'matterId', 'countedOpen'];
    }
    // The values a task may hold after a client write.
    function validTask(data) {
      return data.title is string && data.title.trim().size() > 0 && data.title.size() <= 500
        && data.status in ['todo', 'in_progress', 'blocked', 'done', 'cancelled']
        && data.priority in ['none', 'urgent', 'high', 'medium', 'low']
        && (data.order is int || data.order is float)
        && data.checklist is list && data.checklist.size() <= 100
        && (!('dueDate' in data) || data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('assigneeUid' in data) || data.assigneeUid is string && data.assigneeUid.size() > 0)
        && (!('group' in data) || data.group is string && data.group.size() <= 120);
    }
    // A client-created task: a manual task at this path (`matterId` null for a personal task),
    // created and stamped by the caller, without server-owned fields (completedAt, template keys).
    function newTask(orgId, matterId) {
      let data = request.resource.data;
      return data.keys().hasOnly(taskCreateFields().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
        && data.keys().hasAll(['title', 'status', 'priority', 'checklist', 'order', 'source', 'orgId', 'matterId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
        && data.orgId == orgId && data.matterId == matterId
        && data.source == 'manual' && data.get('countedOpen', false) == false
        && data.createdBy == uid() && data.createdAt == request.time && validMeta() && data.schemaVersion == 1
        && validTask(data);
    }

    // ---------- estate register (CORE-16) ----------
    function estateMatter(orgId, matterId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data;
    }
    // can() has checked the member and the session, so the privileged check reads the role alone:
    // visible() would run the session check again, and the register's validation is long enough
    // that the two together pass the 1000-expression limit on a privileged matter.
    function canEditEstate(orgId, matterId) {
      let matter = estateMatter(orgId, matterId);
      return can(orgId, 'matter.edit')
        && (matter.privileged == false || claimRole() in perm('privileged.view'))
        && matter.get('deletedAt', null) == null && matter.status != 'archived';
    }
    // A client-created register record: only its own fields plus meta, created and stamped by the caller.
    function newEstateRecord(fields, required) {
      let data = request.resource.data;
      return data.keys().hasOnly(fields.concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
        && data.keys().hasAll(required.concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
        && data.createdBy == uid() && data.createdAt == request.time && validMeta() && data.schemaVersion == 1;
    }
    function cents(data, field) {
      return data[field] is int && data[field] >= 0;
    }
    function optionalCents(data, field) {
      return !(field in data) || cents(data, field);
    }
    function text(data, field, max) {
      return data[field] is string && data[field].trim().size() > 0 && data[field].size() <= max;
    }
    function optionalText(data, field, max) {
      return !(field in data) || data[field] is string && data[field].size() <= max;
    }
    function optionalDate(data, field) {
      return !(field in data) || data[field] is string && data[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validAsset(data) {
      return data['class'] in ['real_property', 'bank', 'shares', 'superannuation', 'insurance', 'vehicle', 'personal', 'business', 'debt_owed_to_estate', 'other']
        && text(data, 'description', 300)
        && optionalText(data, 'institution', 300) && optionalText(data, 'valuationSource', 300) && optionalText(data, 'notes', 2000)
        && cents(data, 'valueAtDeathCents') && optionalCents(data, 'realisedCents')
        && optionalDate(data, 'valuedOn')
        && data.jointlyHeld is bool && data.passesOutsideEstate is bool
        && (!('jointHolding' in data) || data.jointHolding in ['joint_tenants', 'tenants_in_common'])
        && (!('shareBps' in data) || data.shareBps is int && data.shareBps >= 1 && data.shareBps <= 10000)
        && data.status in ['identified', 'valued', 'realised', 'transferred']
        && (!('originalCurrency' in data) || data.originalCurrency is string && data.originalCurrency.matches('^[A-Z]{3}$'))
        && (!('originalAmount' in data) || (data.originalAmount is int || data.originalAmount is float) && data.originalAmount >= 0)
        && data.documentIds is list && data.documentIds.size() <= 20;
    }
    function validLiability(data) {
      return data['class'] in ['funeral', 'tax', 'debt', 'mortgage', 'costs', 'other']
        && text(data, 'creditor', 300) && optionalText(data, 'reference', 300) && optionalText(data, 'notes', 2000)
        && cents(data, 'amountCents')
        && data.status in ['notified', 'paid', 'disputed'];
    }
    function validDistribution(data) {
      return data.beneficiaryPartyId is string && data.beneficiaryPartyId.size() > 0
        && data.kind in ['specific', 'pecuniary', 'residuary']
        && optionalCents(data, 'amountCents')
        && (!('assetId' in data) || data.assetId is string && data.assetId.size() > 0)
        && optionalText(data, 'share', 300) && optionalText(data, 'notes', 2000)
        && data.status in ['planned', 'approved', 'paid', 'cancelled']
        && optionalDate(data, 'paidOn') && optionalText(data, 'paymentReference', 300)
        && (!('needsValueReview' in data) || data.needsValueReview is bool);
    }

    // ---------- time entries (BILL-01) ----------
    // Fields a client may write when creating a time entry: `TimeEntryCreateInput` in libs/domain
    // (the rules tests check the two agree), plus the meta fields.
    function timeEntryCreateFields() {
      return ['orgId', 'matterId', 'uid', 'date', 'minutes', 'units', 'rateCents', 'amountCents', 'narrative', 'billable', 'status', 'source', 'taskId', 'wipCountedCents'];
    }
    // The values a time entry may hold after a client write (1 minute to 100 hours).
    function validTimeEntry(data) {
      return data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.minutes is int && data.minutes >= 1 && data.minutes <= 6000
        && data.units is int && data.units >= 0
        && data.rateCents is int && data.amountCents is int
        && data.narrative is string && data.narrative.size() <= 2000
        && data.billable is bool
        && (!('taskId' in data) || data.taskId is string && data.taskId.size() > 0);
    }
    // A client-created entry: the caller's own draft at this path, not yet counted into WIP.
    function newTimeEntry(orgId, matterId) {
      let data = request.resource.data;
      return data.keys().hasOnly(timeEntryCreateFields().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
        && data.keys().hasAll(['orgId', 'matterId', 'uid', 'date', 'minutes', 'units', 'rateCents', 'amountCents', 'narrative', 'billable', 'status', 'source', 'wipCountedCents', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
        && data.orgId == orgId && data.matterId == matterId && data.uid == uid()
        && data.status == 'draft' && data.source == 'manual' && data.wipCountedCents == 0
        && data.createdBy == uid() && data.createdAt == request.time && validMeta() && data.schemaVersion == 1
        && validTimeEntry(data);
    }

    // ---------- disbursements (BILL-04) ----------
    // Fields a client may write when creating a disbursement: `DisbursementCreateInput` in
    // libs/domain (the rules tests check the two agree), plus the meta fields.
    function disbursementCreateFields() {
      return ['orgId', 'matterId', 'date', 'description', 'payee', 'category', 'presetId', 'amountExGstCents', 'gstCents', 'amountIncGstCents', 'gstTreatment', 'receiptDocumentId', 'status', 'wipCountedCents'];
    }
    function optionalId(data, field) {
      return data.get(field, null) == null || data.get(field, null) is string && data.get(field, null).size() > 0;
    }
    // The values a disbursement may hold after a client write (up to $1,000,000). The receipt is a
    // document on the same matter.
    function validDisbursement(orgId, matterId, data) {
      return data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.description is string && data.description.trim().size() > 0 && data.description.size() <= 500
        && data.payee is string && data.payee.size() <= 200
        && (data.get('category', null) == null || data.category in ['court_fee', 'advertising', 'search', 'certificate', 'valuation', 'courier', 'other'])
        && optionalId(data, 'presetId')
        && data.amountExGstCents is int && data.amountExGstCents >= 0 && data.amountExGstCents <= 100000000
        && data.gstCents is int && data.gstCents >= 0
        && (data.get('amountIncGstCents', null) == null
          || data.amountIncGstCents is int && data.amountIncGstCents > 0 && data.amountIncGstCents <= 100000000)
        && data.gstTreatment in ['taxable', 'gst_free', 'input_taxed']
        && optionalId(data, 'receiptDocumentId')
        && (data.get('receiptDocumentId', null) == null
          || exists(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)/documents/$(data.receiptDocumentId)));
    }
    // A client-created disbursement: unbilled on this matter, not yet counted.
    function newDisbursement(orgId, matterId) {
      let data = request.resource.data;
      return data.keys().hasOnly(disbursementCreateFields().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
        && data.keys().hasAll(['orgId', 'matterId', 'date', 'description', 'payee', 'amountExGstCents', 'gstCents', 'gstTreatment', 'status', 'wipCountedCents', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
        && data.orgId == orgId && data.matterId == matterId
        && data.status == 'unbilled' && data.wipCountedCents == 0
        && data.createdBy == uid() && data.createdAt == request.time && validMeta() && data.schemaVersion == 1
        && validDisbursement(orgId, matterId, data);
    }
    // The org's presets (BILL-04): a list the client validates (`DisbursementPresetsSchema`); readers
    // fall back to the starting presets when it is malformed.
    function validPresets() {
      let data = request.resource.data;
      return data.keys().hasOnly(['presets', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
        && data.presets is list && data.presets.size() <= 50 && validMeta();
    }

    // ---------- deadlines (CORE-10) ----------
    // Fields a client may write when creating a manual deadline: `ManualDeadlineCreateInput` in
    // libs/domain (the rules tests check the two agree), plus the meta fields.
    function manualDeadlineCreateFields() {
      return ['orgId', 'matterId', 'title', 'dueDate', 'dueTime', 'kind', 'critical', 'status', 'assigneeUid', 'reminders', 'privileged'];
    }
    // The values a manual deadline may hold after a client write.
    function validManualDeadline(data) {
      return data.title is string && data.title.trim().size() > 0 && data.title.size() <= 300
        && data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('dueTime' in data) || data.dueTime is string && data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && data.kind in ['contractual', 'internal', 'court']
        && data.critical is bool
        && data.assigneeUid is string && data.assigneeUid.size() > 0
        && data.reminders is list && data.reminders.size() <= 10
        && data.get('computed', null) == null;
    }
    // A client-created manual deadline at this path, upcoming, stamped by the caller.
    function newManualDeadline(orgId, matterId) {
      let data = request.resource.data;
      return data.keys().hasOnly(manualDeadlineCreateFields().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
        && data.keys().hasAll(['orgId', 'matterId', 'title', 'dueDate', 'kind', 'critical', 'status', 'assigneeUid', 'reminders', 'privileged', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
        && data.orgId == orgId && data.matterId == matterId && data.status == 'upcoming'
        && data.createdBy == uid() && data.createdAt == request.time && validMeta() && data.schemaVersion == 1
        && validManualDeadline(data);
    }

    // ---------- global reference data (read-only for clients) ----------
    match /ruleSets/{ruleSetId} {
      allow read: if isSignedIn();
      match /versions/{version} {
        allow read: if isSignedIn();
      }
    }
    match /calendars/{calendarId} {
      allow read: if isSignedIn();
    }
    match /systemTemplates/{templateId} {
      allow read: if isSignedIn();
    }

    // ---------- users ----------
    match /users/{userId} {
      // Notification preferences (FND-20), when present, hold sensible values, and never switch off
      // email or in-app for deadline escalations (the locked rows in Settings → Preferences, CORE-20).
      // The server enforces the real constraint whatever is stored (critical notifications always
      // email); this only keeps the stored choice honest.
      function notificationPrefsOk(data) {
        let prefs = data.get('prefs', {});
        let n = prefs.get('notifications', null);
        return n == null || (
          n is map
          && n.get('email', true) is bool && n.get('push', false) is bool
          && n.get('digestHour', 7) is int && n.get('digestHour', 7) >= 0 && n.get('digestHour', 7) <= 23
          && n.get('kinds', {}) is map
          && n.get('kinds', {}).get('deadline_escalation', {}).get('email', true) == true
          && n.get('kinds', {}).get('deadline_escalation', {}).get('inapp', true) == true
          && n.get('taskReminderDays', 1) is int && n.get('taskReminderDays', 1) >= 0 && n.get('taskReminderDays', 1) <= 14
        );
      }
      allow read: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && uid() == userId && clientUpdate(fieldsUser())
        && notificationPrefsOk(request.resource.data);

      // Push devices (FND-20): `{token, platform, lastSeenAt}`, private to their user, registered,
      // refreshed and removed by the client. Functions prune tokens FCM reports gone.
      match /devices/{deviceId} {
        function isDeviceOwner() {
          return isSignedIn() && uid() == userId;
        }
        function validDevice(data) {
          return data.token is string && data.token.size() > 0 && data.token.size() <= 4096
            && data.platform in ['web', 'ios', 'android']
            && data.lastSeenAt is timestamp;
        }
        function deviceKeys() {
          return fieldsDevice().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']);
        }
        allow read, delete: if isDeviceOwner();
        allow create: if isDeviceOwner()
          && request.resource.data.keys().hasOnly(deviceKeys())
          && request.resource.data.keys().hasAll(deviceKeys())
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && validMeta() && request.resource.data.schemaVersion == 1
          && validDevice(request.resource.data);
        allow update: if isDeviceOwner() && clientUpdate(fieldsDevice()) && validDevice(request.resource.data);
      }

      // The global timer (BILL-02): one document, `current`, private to its user, started (by
      // time.record roles) in their current org, paused, resumed and discarded by the client (a transaction makes two tabs starting at once end with
      // one timer). Its matter never changes (switching stops
      // or discards it first). `startedAt` is the server's time unless the timer was started
      // offline (`clientStarted`), and every write stamps `lastHeartbeatAt` with it, which each
      // device measures its clock skew from. `forgotten` is server-owned (time-flagForgottenTimers);
      // time-stopTimer saves the time entries and deletes the timer.
      match /timer/{timerId} {
        function isTimerOwner() {
          return isSignedIn() && uid() == userId && timerId == 'current';
        }
        // Fields a client may write when starting a timer: `Timer.create` in libs/domain (the rules
        // tests check the two agree), plus the meta fields.
        function timerCreateFields() {
          return ['orgId', 'matterId', 'matterNumber', 'taskId', 'startedAt', 'accumulatedMs', 'running', 'narrativeDraft', 'lastHeartbeatAt', 'clientStarted', 'needsReview', 'forgottenSeenAt'];
        }
        function validTimer(data) {
          return data.matterId is string && data.matterId.size() > 0
            && data.matterNumber is string && data.matterNumber.size() > 0 && data.matterNumber.size() <= 64
            && (!('taskId' in data) || data.taskId is string && data.taskId.size() > 0)
            && data.startedAt is timestamp
            && data.accumulatedMs is int && data.accumulatedMs >= 0 && data.accumulatedMs <= 5040000000
            && data.running is bool
            && data.narrativeDraft is string && data.narrativeDraft.size() <= 2000
            && data.lastHeartbeatAt == request.time
            && data.get('clientStarted', false) is bool
            && data.get('needsReview', false) is bool
            && (!('forgottenSeenAt' in data) || data.forgottenSeenAt is timestamp);
        }
        // A server-time start, or the device's clock when started offline.
        function startOk(data) {
          return data.startedAt == request.time || data.get('clientStarted', false) == true;
        }
        allow read, delete: if isTimerOwner();
        allow create: if isTimerOwner()
          && request.resource.data.keys().hasOnly(timerCreateFields().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
          && request.resource.data.keys().hasAll(['orgId', 'matterId', 'matterNumber', 'startedAt', 'accumulatedMs', 'running', 'narrativeDraft', 'lastHeartbeatAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
          && request.resource.data.orgId == claimOrg() && can(claimOrg(), 'time.record')
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && validMeta() && request.resource.data.schemaVersion == 1
          && validTimer(request.resource.data) && startOk(request.resource.data)
          && !('forgottenSeenAt' in request.resource.data);
        allow update: if isTimerOwner() && clientUpdate(fieldsTimer())
          && validTimer(request.resource.data)
          && (unchanged(['startedAt']) || startOk(request.resource.data))
          && (unchanged(['forgottenSeenAt']) || request.resource.data.forgottenSeenAt == request.time);
      }

      // Server-only: MFA recovery code hashes and sign-in stamps (FND-16). Not even the owner reads them.
      match /private/{docId} {
        allow read, write: if false;
      }

      // The sign-in log (SEC-04): written by auth-beforeSignIn, read by its owner ("Your sessions").
      // Firestore TTL deletes an entry at `expireAt`.
      match /signIns/{signInId} {
        allow read: if isSignedIn() && uid() == userId;
      }

      // Saved Matters list views (CORE-03): private to their user, created, edited and deleted by the
      // client. Each names the org it was saved in, which must be the caller's current org.
      match /views/{viewId} {
        function isSelf() {
          return isSignedIn() && uid() == userId;
        }
        function validView(data) {
          return data.orgId == claimOrg() && inOrg(claimOrg())
            && data.list == 'matters'
            && data.name is string && data.name.size() > 0 && data.name.size() <= 60
            && data.filters is map && data.sort is map
            && data.groupBy in ['none', 'status', 'type', 'responsible'];
        }
        allow read, delete: if isSelf();
        allow create: if isSelf()
          && request.resource.data.keys().hasOnly(fieldsSavedView().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
          && request.resource.data.keys().hasAll(fieldsSavedView().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && validMeta() && request.resource.data.schemaVersion == 1
          && validView(request.resource.data);
        allow update: if isSelf() && clientUpdate(fieldsSavedView()) && validView(request.resource.data);
      }

      // New matter intake drafts (CORE-05): `intake-{id}`, private to their user, written by the
      // client directly. The form state is JSON text of at most 100,000 characters
      // (INTAKE_DRAFT_MAX_STATE_CHARS); `expireAt` is about 30 days after the save (a day's slack
      // for the client's clock) and Firestore TTL deletes the draft then.
      match /drafts/{draftId} {
        function isDraftOwner() {
          return isSignedIn() && uid() == userId;
        }
        function validDraft(data) {
          return draftId.matches('^intake-[A-Za-z0-9_-]{1,64}$')
            && data.orgId == claimOrg() && inOrg(claimOrg())
            && data.kind == 'intake'
            && data.step in ['type', 'clients', 'details', 'parties', 'fees', 'conflict', 'review']
            && data.stateJson is string && data.stateJson.size() <= 100000
            && data.expireAt is timestamp
            && data.expireAt > request.time + duration.value(29, 'd')
            && data.expireAt <= request.time + duration.value(31, 'd');
        }
        allow read, delete: if isDraftOwner();
        allow create: if isDraftOwner()
          && request.resource.data.keys().hasOnly(fieldsIntakeDraft().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
          && request.resource.data.keys().hasAll(fieldsIntakeDraft().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && validMeta() && request.resource.data.schemaVersion == 1
          && validDraft(request.resource.data);
        allow update: if isDraftOwner() && clientUpdate(fieldsIntakeDraft()) && validDraft(request.resource.data);
      }

      // Recently opened things (CORE-14 matters; CORE-15 contacts, tasks and documents), private to
      // their user. Opening one writes the whole entry again (a set: a create the first time, an
      // update after), so `updatedAt` is when it was last opened. Each names something in the
      // caller's current org, by id only: a matter as `{orgId}_{matterId}` (no `kind` before
      // CORE-15), anything else as `{orgId}_{kind}[_{matterId}]_{entityId}` (`recentEntryId`).
      // `expireAt` is about 90 days on (a day's slack for the client's clock) and Firestore TTL
      // deletes the entry then.
      match /recent/{recentId} {
        function isRecentOwner() {
          return isSignedIn() && uid() == userId;
        }
        function idOk(data) {
          return data.get('matterId', '') is string && data.get('entityId', '') is string;
        }
        function validRef(data) {
          let kind = data.get('kind', 'matter');
          let matterId = data.get('matterId', '');
          let entityId = data.get('entityId', '');
          return kind in ['matter', 'contact', 'task', 'document']
            && (kind == 'matter'
                && matterId.size() > 0 && !('entityId' in data)
                && recentId == data.orgId + '_' + matterId
              || kind != 'matter'
                && entityId.size() > 0
                && (kind != 'contact' || !('matterId' in data))
                && (kind != 'document' || matterId.size() > 0)
                && recentId == data.orgId + '_' + kind + (matterId.size() > 0 ? '_' + matterId : '') + '_' + entityId);
        }
        function validRecent(data) {
          return data.orgId == claimOrg() && inOrg(claimOrg())
            && idOk(data) && validRef(data)
            && data.expireAt is timestamp
            && data.expireAt > request.time + duration.value(89, 'd')
            && data.expireAt <= request.time + duration.value(91, 'd');
        }
        function recentKeys() {
          return fieldsRecentMatter().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']);
        }
        allow read, delete: if isRecentOwner();
        allow create, update: if isRecentOwner()
          && request.resource.data.keys().hasOnly(recentKeys())
          && request.resource.data.keys().hasAll(['orgId', 'expireAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt is timestamp
          && validMeta() && request.resource.data.schemaVersion == 1
          && validRecent(request.resource.data);
      }
    }

    // ---------- organisations ----------
    match /orgs/{orgId} {
      // Readable whatever the security policy says (memberOf, not inOrg), so the app can tell a
      // member why their session isn't accepted (MFA required, session expired, signed out).
      allow read: if memberOf(orgId);
      // Clerk's settings (`settings.clerk`: switches, limits, the disclosure acknowledgement) change
      // only through the audited clerk-* callables (AI-02a, AI-13), even when a client rewrites
      // another part of `settings` (referrals, CORE-18).
      allow update: if can(orgId, 'org.settings') && isActiveMember(orgId) && clientUpdate(fieldsOrg())
        && request.resource.data.get('settings', {}).get('clerk', null) == resource.data.get('settings', {}).get('clerk', null);

      match /members/{memberUid} {
        // Their own member document likewise (its `sessionsValidAfter`); everyone else's needs inOrg.
        allow read: if inOrg(orgId) || memberOf(orgId) && uid() == memberUid;
        // Owners and admins edit any member; everyone edits their own profile fields (CORE-20).
        allow update: if can(orgId, 'members.manage') && isActiveMember(orgId) && clientUpdate(fieldsMember())
          || inOrg(orgId) && uid() == memberUid && resource.data.status == 'active'
            && clientUpdate(['displayName', 'initials', 'title', 'admissionNo', 'colour'])
            && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 80;

        // Personal tasks (CORE-08): the member's own, invisible to everyone else (admins included).
        // Created by their owner with `matterId: null` and the owner as the assignee, which never
        // changes, so the `tasks` collection group only shows them to their owner.
        match /tasks/{taskId} {
          function isTaskOwner() {
            return inOrg(orgId) && uid() == memberUid;
          }
          allow read: if isTaskOwner();
          allow create: if isTaskOwner() && newTask(orgId, null) && request.resource.data.assigneeUid == memberUid;
          allow update: if isTaskOwner()
            && (clientUpdate(fieldsPersonalTask()) && validTask(request.resource.data)
                && request.resource.data.get('assigneeUid', memberUid) == memberUid
              || softDelete());
        }
      }

      match /invites/{inviteId} {
        allow read: if can(orgId, 'members.manage') && isActiveMember(orgId);
        allow update: if can(orgId, 'members.manage') && isActiveMember(orgId) && clientUpdate(fieldsInvite());
      }

      // Contacts (CORE-01): created, merged and deleted-with-checks through the contacts-* callables;
      // clients edit whitelisted fields and soft delete. A merge tombstone (mergedInto set) is frozen.
      match /contacts/{contactId} {
        allow read: if inOrg(orgId);
        allow update: if resource.data.get('mergedInto', null) == null
          && (can(orgId, 'contact.edit') && clientUpdate(fieldsContact())
            || can(orgId, 'contact.delete') && softDelete());
      }

      // Matters (CORE-03): created (numbered), moved between statuses and restored through the
      // matters-* callables. Clients edit whitelisted fields of a live matter and soft delete it;
      // a deleted matter is frozen until an owner or admin restores it (matters-restore, 30 days).
      match /matters/{matterId} {
        // Archived matters (CORE-19) are read-only: their records change only through callables
        // (reopening, and notes by lawyers and above). Destroyed ones are tombstones (deletedAt).
        function matterWritable() {
          return get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data.status != 'archived';
        }
        allow read: if inOrg(orgId) && visible(orgId, resource.data);
        allow update: if visibleAndFlagOk(orgId, [resource.data.privileged])
          && resource.data.get('deletedAt', null) == null && resource.data.status != 'archived'
          && (can(orgId, 'matter.edit') && clientUpdate(fieldsMatter()) || can(orgId, 'matter.delete') && softDeleteOnly());

        // Server-written feed.
        match /activity/{activityId} {
          allow read: if inOrg(orgId);
        }

        // Matter tasks (CORE-08) follow the matter's access: whoever can read the matter reads its
        // tasks (a privileged matter's need privileged.view); task.edit roles create manual tasks,
        // edit the whitelisted fields and soft delete (or restore) them on a live matter.
        // tasks-onWrite keeps openTaskCount, completedAt and countedOpen.
        match /tasks/{taskId} {
          function taskMatter() {
            return get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data;
          }
          function canEditTasks() {
            return can(orgId, 'task.edit') && visible(orgId, taskMatter()) && taskMatter().get('deletedAt', null) == null
              && taskMatter().status != 'archived';
          }
          allow read: if inOrg(orgId) && visible(orgId, taskMatter());
          // `countedOpen: false` says the task isn't in openTaskCount yet (tasks-onWrite counts it).
          allow create: if canEditTasks() && newTask(orgId, matterId) && request.resource.data.countedOpen == false;
          allow update: if canEditTasks()
            && (clientUpdate(fieldsTask()) && validTask(request.resource.data) || softDelete());
        }

        // Deadlines (CORE-10, ADR-027). Computed deadlines (with `computed` provenance) are written by
        // the deadlines-* functions: clients only reassign or acknowledge them; overrides, proposals
        // and closing go through callables. task.edit roles create manual deadlines (contractual,
        // internal or court) on a live, visible matter, edit their whitelisted fields while upcoming,
        // and soft delete them. Status changes (done, waived, missed) go through deadlines-complete.
        // Reads follow the matter's access, like tasks (CORE-10b): a privileged matter's deadlines
        // need privileged.view. Each deadline carries a copy of the matter's `privileged` flag for the
        // collection-group rule below; a manual one is created with the matter's.
        match /deadlines/{deadlineId} {
          function deadlineMatter() {
            return get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data;
          }
          function canEditDeadlines() {
            return can(orgId, 'task.edit') && visible(orgId, deadlineMatter()) && deadlineMatter().get('deletedAt', null) == null
              && deadlineMatter().status != 'archived';
          }
          function acknowledged() {
            return unchanged(['ackBy', 'ackAt'])
              || request.resource.data.get('ackBy', null) == uid() && request.resource.data.get('ackAt', null) == request.time;
          }
          allow read: if inOrg(orgId) && visible(orgId, deadlineMatter());
          allow create: if canEditDeadlines() && newManualDeadline(orgId, matterId)
            && request.resource.data.privileged == deadlineMatter().privileged;
          allow update: if canEditDeadlines() && (
            resource.data.get('computed', null) == null && (
              resource.data.status == 'upcoming'
                && clientUpdate(fieldsDeadline()) && acknowledged() && validManualDeadline(request.resource.data)
              || softDelete())
            || resource.data.get('computed', null) != null
              && resource.data.status in ['upcoming', 'blocked']
              && clientUpdate(['assigneeUid', 'ackBy', 'ackAt']) && acknowledged()
              && request.resource.data.assigneeUid is string && request.resource.data.assigneeUid.size() > 0);
        }

        // Proposed changes to computed deadlines (CORE-10): server-written, decided through
        // deadlines-resolveChange. Readable like the matter's deadlines (CORE-10b).
        match /deadlineChanges/{changeId} {
          allow read: if inOrg(orgId)
            && visible(orgId, get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data);
        }

        // Time entries (BILL-01): drafts are written client-direct by their author (or anyone with
        // time.approve) on a live matter they can see. time-onWrite recomputes units, rate and amount
        // and keeps the matter's wipCents; final, billed and written-off entries change only through
        // callables (invariant 5: billed entries are immutable).
        match /timeEntries/{entryId} {
          function timeMatter() {
            return get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data;
          }
          function canWriteTime(authorUid) {
            return (can(orgId, 'time.approve') || can(orgId, 'time.record') && authorUid == uid())
              && visible(orgId, timeMatter()) && timeMatter().get('deletedAt', null) == null
              && timeMatter().status != 'archived';
          }
          allow read: if inOrg(orgId) && visible(orgId, timeMatter());
          allow create: if can(orgId, 'time.record') && newTimeEntry(orgId, matterId)
            && visible(orgId, timeMatter()) && timeMatter().get('deletedAt', null) == null
            && timeMatter().status != 'archived';
          allow update: if canWriteTime(resource.data.uid)
            && resource.data.status == 'draft'
            && (clientUpdate(fieldsTimeEntry()) && validTimeEntry(request.resource.data) || softDelete());
        }

        // Matter documents (CORE-12, ADR-028): created, scanned and versioned by documents-onUpload
        // and the documents-* callables. Clients read the documents of matters they can see
        // (privileged documents and matters need privileged.view, so never readonly), including
        // soft-deleted ones (citations still resolve); document.upload roles edit the name,
        // category, tags, notes and (lawyers and above) the privileged flag; document.delete roles
        // soft delete and restore. Scan, version, hash and upload fields are server-owned, and the
        // files themselves are read only through signed URLs (documents-getDownloadUrl).
        match /documents/{documentId} {
          function documentMatter() {
            return get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data;
          }
          function validDocumentMeta(data) {
            return data.name is string && data.name.trim().size() > 0 && data.name.size() <= 255
              && data.category in ['will', 'codicil', 'death_certificate', 'grant', 'affidavit', 'correspondence', 'court_document', 'order', 'financial', 'id', 'other']
              && data.privileged is bool
              && data.get('accessRestricted', false) is bool
              && data.get('tags', []) is list && data.get('tags', []).size() <= 20
              && (!('notes' in data) || data.notes is string && data.notes.size() <= 5000);
          }
          allow read: if inOrg(orgId) && visible(orgId, resource.data) && visible(orgId, documentMatter());
          allow update: if visibleAndFlagOk(orgId, [resource.data.privileged, documentMatter().privileged])
            && documentMatter().status != 'archived'
            && (can(orgId, 'document.upload') && clientUpdate(fieldsMatterDocument()) && validDocumentMeta(request.resource.data)
              || can(orgId, 'document.delete') && softDelete());

          // Embeddings for retrieval: server only, never read by clients.
          match /chunks/{chunkId} {
            allow read, write: if false;
          }
        }

        // Content-hash index for duplicate detection (CORE-12): server-only.
        match /documentHashes/{hash} {
          allow read, write: if false;
        }

        // Notes (CORE-13): created and their text edited only through notes-create and notes-update
        // (mentions, revisions, notifications). note.write roles pin, soft delete and restore
        // directly; the privileged flag isn't client-writable (visibleAndFlagOk stays as a guard).
        match /notes/{noteId} {
          allow read: if inOrg(orgId) && visible(orgId, resource.data);
          allow update: if visibleAndFlagOk(orgId, [resource.data.privileged])
            && editable(orgId, 'note.write', fieldsNote()) && matterWritable();

          // Earlier versions, appended by notes-update. Readable by whoever can read the note, and
          // a version that was privileged needs privileged.view itself (so a list by a role without
          // it proves `privileged == false`). Server-only writes.
          match /revisions/{revisionId} {
            allow read: if inOrg(orgId) && visible(orgId, resource.data)
              && visible(orgId, get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)/notes/$(noteId)).data);
          }
        }

        match /offers/{offerId} {
          allow read: if inOrg(orgId) && visible(orgId, resource.data);
          allow update: if visibleAndFlagOk(orgId, [resource.data.privileged])
            && editable(orgId, 'matter.edit', fieldsOffer()) && matterWritable();
        }

        // Clerk suggestions (AI-07, ADR-037): written only by functions (proposeSuggestions and the
        // suggestions-* callables, which accept and dismiss them with audit and metrics). Privileged
        // ones (drawn from privileged material) need privileged.view, like notes and documents, so
        // a list by a role without it must prove `privileged == false`.
        match /suggestions/{suggestionId} {
          allow read: if inOrg(orgId) && visible(orgId, resource.data);
        }

        // Where Clerk found a key fact's value (CORE-06a, ADR-049): written by suggestions-accept
        // and deleted by matters-denormalise once the fact changes; server-only writes. Readable by
        // whoever can read the matter, and a privileged one (from a privileged suggestion or cited
        // document) needs privileged.view, so a list by a role without it proves `privileged == false`.
        match /factCitations/{factId} {
          allow read: if inOrg(orgId) && visible(orgId, resource.data)
            && visible(orgId, get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data);
        }

        match /parties/{partyId} {
          allow read: if inOrg(orgId);
          // Share and notes only: adding, re-roling and removing parties go through the
          // matters-upsertParty and matters-removeParty callables, which keep clientContactIds and
          // the last-client rule (CORE-06). No client soft delete.
          allow update: if can(orgId, 'matter.edit') && clientUpdate(fieldsParty()) && matterWritable();
        }
        // Matter events (CORE-10): written through deadlines-upsertEvent and deadlines-deleteEvent,
        // which recompute the matter's deadlines in the same transaction. Readable like the matter's
        // deadlines (CORE-10b).
        match /events/{eventId} {
          allow read: if inOrg(orgId)
            && visible(orgId, get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data);
        }
        // Disbursements (BILL-04): unbilled ones are written client-direct by time.record roles on a
        // live matter they can see. disbursements-onWrite recomputes the GST and keeps the matter's
        // disbursementWipCents; writing off goes through disbursements-setStatus, and billed ones
        // never change from a client (invariant 5).
        match /disbursements/{disbursementId} {
          function disbursementMatter() {
            return get(/databases/$(database)/documents/orgs/$(orgId)/matters/$(matterId)).data;
          }
          function canWriteDisbursement() {
            return can(orgId, 'time.record')
              && visible(orgId, disbursementMatter()) && disbursementMatter().get('deletedAt', null) == null
              && disbursementMatter().status != 'archived';
          }
          allow read: if inOrg(orgId) && visible(orgId, disbursementMatter());
          allow create: if canWriteDisbursement() && newDisbursement(orgId, matterId);
          allow update: if canWriteDisbursement() && resource.data.status == 'unbilled'
            && (clientUpdate(fieldsDisbursement()) && validDisbursement(orgId, matterId, request.resource.data) || softDelete());
        }
        // The estate register (CORE-16): assets, liabilities and distributions follow the matter's
        // access (a privileged matter's need privileged.view). matter.edit roles create them, edit
        // the whitelisted fields and soft delete (or restore) them on a live matter, with every
        // amount integer cents of 0 or more. estate-onWrite keeps the matter's totals and flags
        // distributions for review; neither is client-written.
        match /assets/{assetId} {
          allow read: if inOrg(orgId) && visible(orgId, estateMatter(orgId, matterId));
          allow create: if canEditEstate(orgId, matterId)
            && newEstateRecord(fieldsAsset(), ['class', 'description', 'valueAtDeathCents', 'jointlyHeld', 'passesOutsideEstate', 'status', 'documentIds'])
            && validAsset(request.resource.data);
          allow update: if canEditEstate(orgId, matterId)
            && (clientUpdate(fieldsAsset()) && validAsset(request.resource.data) || softDelete());
        }
        match /liabilities/{liabilityId} {
          allow read: if inOrg(orgId) && visible(orgId, estateMatter(orgId, matterId));
          allow create: if canEditEstate(orgId, matterId)
            && newEstateRecord(fieldsLiability(), ['class', 'creditor', 'amountCents', 'status'])
            && validLiability(request.resource.data);
          allow update: if canEditEstate(orgId, matterId)
            && (clientUpdate(fieldsLiability()) && validLiability(request.resource.data) || softDelete());
        }
        match /distributions/{distributionId} {
          allow read: if inOrg(orgId) && visible(orgId, estateMatter(orgId, matterId));
          allow create: if canEditEstate(orgId, matterId)
            && newEstateRecord(fieldsDistribution(), ['beneficiaryPartyId', 'kind', 'status'])
            && request.resource.data.get('needsValueReview', false) == false
            && validDistribution(request.resource.data);
          // A person clears needsValueReview; only estate-onWrite sets it.
          allow update: if canEditEstate(orgId, matterId)
            && (clientUpdate(fieldsDistribution()) && validDistribution(request.resource.data)
                && (unchanged(['needsValueReview']) || request.resource.data.get('needsValueReview', false) == false)
              || softDelete());
        }
        match /proceedings/{proceedingId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsProceeding()) && matterWritable();
        }
        match /courtEvents/{courtEventId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsCourtEvent()) && matterWritable();
        }
        match /orders/{orderId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsCourtOrder()) && matterWritable();
        }
        match /chronology/{entryId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsChronologyEntry()) && matterWritable();
        }
        match /issues/{issueId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsIssue()) && matterWritable();
        }
        match /evidence/{evidenceId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsEvidence()) && matterWritable();
        }
        match /subpoenas/{subpoenaId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsSubpoena()) && matterWritable();
        }
        match /courtBooks/{courtBookId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsCourtBook()) && matterWritable();
        }

        // Clerk's draft letters (AI-10, ADR-050): private to the person who asked for one, and a
        // privileged draft (Clerk drew on privileged material, rule 6) needs privileged.view, so a
        // list must prove `ownerUid == uid()` and `privileged == false` for a role without it.
        // clerk-startDraft creates them and clerk-runDraft writes Clerk's text. The owner edits the
        // body and who wrote what once Clerk has finished, asks a running draft to stop, or deletes
        // it; saving goes through clerk-saveDraft.
        match /clerkDrafts/{draftId} {
          function draftEditOk() {
            return (unchanged(['bodyMd', 'provenance']) || resource.data.status != 'drafting')
              && (unchanged(['stopRequested'])
                || resource.data.status == 'drafting' && request.resource.data.stopRequested == true)
              && request.resource.data.bodyMd is string && request.resource.data.bodyMd.size() <= 50000
              && request.resource.data.provenance is list && request.resource.data.provenance.size() <= 2000;
          }
          allow read: if can(orgId, 'clerk.use') && resource.data.ownerUid == uid() && visible(orgId, resource.data);
          allow update: if can(orgId, 'clerk.use') && resource.data.ownerUid == uid() && matterWritable()
            && (clientUpdate(fieldsClerkDraft()) && draftEditOk() || softDelete());
        }
      }

      // Clerk threads (AI-06, ADR-044): private to their owner until shared with the matter team.
      // A privileged thread or message (drawn from privileged material, Clerk rule 6) needs
      // privileged.view as well, even when shared (ADR-034), so a list by a role without it must
      // prove `privileged == false`. Threads and messages are created by clerk-sendMessage.
      match /clerkThreads/{threadId} {
        function thread() {
          return get(/databases/$(database)/documents/orgs/$(orgId)/clerkThreads/$(threadId)).data;
        }
        function readable(data) {
          return can(orgId, 'clerk.use') && (data.ownerUid == uid() || data.shared == true) && visible(orgId, data);
        }
        allow read: if readable(resource.data);
        allow update: if can(orgId, 'clerk.use') && resource.data.ownerUid == uid()
          && (clientUpdate(fieldsClerkThread()) || softDelete());

        match /messages/{messageId} {
          allow read: if readable(thread()) && visible(orgId, resource.data);
          // The thread owner can ask a running reply to stop.
          allow update: if can(orgId, 'clerk.use') && thread().ownerUid == uid() && clientUpdate(fieldsClerkMessage());
        }
      }

      // Invoices and credit notes (BILL-07): billing.view reads them; every write (pre-bills too,
      // whose lines the server builds) goes through the billing-* callables, so an issued invoice
      // is never changed by a client.
      match /invoices/{invoiceId} {
        allow read: if can(orgId, 'billing.view');
      }
      match /creditNotes/{creditNoteId} {
        allow read: if can(orgId, 'billing.view');
      }
      // Payment reminders (BILL-08): queued by the nightly job, sent or dismissed through
      // billing-sendReminder and -dismissReminder; billing.view reads them.
      match /invoiceReminders/{reminderId} {
        allow read: if can(orgId, 'billing.view');
      }

      // Matter templates (CORE-07): every member reads drafts and published versions (the stepper
      // reads a matter's version); writes go through the templates-* callables only.
      match /templates/{templateId} {
        allow read: if inOrg(orgId);
        match /versions/{version} {
          allow read: if inOrg(orgId);
        }
      }
      // Checklist templates (CORE-08d): every member reads and applies them to tasks; task.edit
      // roles create them, edit the whitelisted fields and soft delete (or restore) them. Items are
      // 1 to 30 single lines of at most 200 characters (`ChecklistTemplate` in libs/domain): joined
      // with newlines, every line is 1 to 200 characters, and splitting gives the same strings back
      // (no item holds a newline or isn't a string). Clients trim the items.
      match /checklistTemplates/{templateId} {
        function validChecklistTemplate(data) {
          return data.name is string && data.name.trim().size() > 0 && data.name.size() <= 100
            && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
            && data.items.join('\n').matches('[^\n]{1,200}(\n[^\n]{1,200})*')
            && data.items.join('\n').split('\n') == data.items
            && (!('priority' in data) || data.priority in ['none', 'urgent', 'high', 'medium', 'low'])
            && (!('dueInDays' in data) || data.dueInDays is int && data.dueInDays >= 0 && data.dueInDays <= 365);
        }
        function canEditChecklistTemplates() {
          return can(orgId, 'task.edit') && isActiveMember(orgId);
        }
        allow read: if inOrg(orgId);
        allow create: if canEditChecklistTemplates()
          && request.resource.data.keys().hasOnly(fieldsChecklistTemplate().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
          && request.resource.data.keys().hasAll(['name', 'items', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && validMeta() && request.resource.data.schemaVersion == 1
          && validChecklistTemplate(request.resource.data);
        allow update: if canEditChecklistTemplates()
          && (clientUpdate(fieldsChecklistTemplate()) && validChecklistTemplate(request.resource.data) || softDelete());
      }
      // Task group templates (CORE-08f): a group of tasks with their checklists, applied to a
      // matter's Tasks tab. The rules check the name and list sizes; the tasks' shape is checked by
      // the schema on read (rules can't walk a list of maps).
      match /taskGroupTemplates/{templateId} {
        function validTaskGroupTemplate(data) {
          return data.name is string && data.name.trim().size() > 0 && data.name.size() <= 120
            && data.tasks is list && data.tasks.size() >= 1 && data.tasks.size() <= 50;
        }
        function canEditTaskGroupTemplates() {
          return can(orgId, 'task.edit') && isActiveMember(orgId);
        }
        allow read: if inOrg(orgId);
        allow create: if canEditTaskGroupTemplates()
          && request.resource.data.keys().hasOnly(fieldsTaskGroupTemplate().concat(['createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion']))
          && request.resource.data.keys().hasAll(['name', 'tasks', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && validMeta() && request.resource.data.schemaVersion == 1
          && validTaskGroupTemplate(request.resource.data);
        allow update: if canEditTaskGroupTemplates()
          && (clientUpdate(fieldsTaskGroupTemplate()) && validTaskGroupTemplate(request.resource.data) || softDelete());
      }
      // Document templates (INT-06): every member reads them (to generate on a matter); uploads,
      // versions, publishing and deletes go through the docs-* callables, which check the tags
      // and scan the file.
      match /docTemplates/{templateId} {
        allow read: if inOrg(orgId);
      }

      // Original will packets (CORE-17): every member reads the register; every write goes
      // through the safeCustody-* callables, so each movement carries its authority.
      match /safeCustody/{packetId} {
        allow read: if inOrg(orgId);
      }

      // Each member reads, marks read (or unread) and archives (or restores) only their own
      // notifications (FND-20, CORE-22): a changed `readAt` or `hiddenAt` is the server's time, or null.
      match /notifications/{notificationId} {
        function stampedOrCleared(field) {
          return !(field in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.get(field, null) == null
            || request.resource.data.get(field, null) == request.time;
        }
        allow read: if inOrg(orgId) && resource.data.recipientUid == uid();
        allow update: if inOrg(orgId) && resource.data.recipientUid == uid() && clientUpdate(fieldsNotification())
          && stampedOrCleared('readAt') && stampedOrCleared('hiddenAt');
      }

      // Background jobs (FND-24): written by functions and the Cloud Run job; the member who
      // started a job watches its progress.
      match /jobs/{jobId} {
        allow read: if inOrg(orgId) && resource.data.createdBy == uid();
      }

      // Matter destruction (CORE-19): the queue and certificates are written by the matters-*
      // functions; owners and admins review them.
      match /destructionQueue/{matterId} {
        allow read: if can(orgId, 'matter.destroy');
      }
      match /destructionCertificates/{certificateId} {
        allow read: if can(orgId, 'matter.destroy');
      }

      // Disbursement presets (BILL-04): every member reads them to prefill a disbursement; owners and
      // admins keep the list. Other settings documents stay server-only.
      // The letterhead's contact details (INT-06): every member reads them; docs-saveLetterhead writes.
      match /settings/letterhead {
        allow read: if inOrg(orgId);
      }

      match /settings/disbursementPresets {
        allow read: if inOrg(orgId);
        allow create: if can(orgId, 'org.settings') && validPresets()
          && request.resource.data.createdBy == uid() && request.resource.data.createdAt == request.time
          && request.resource.data.schemaVersion == 1;
        allow update: if can(orgId, 'org.settings') && clientUpdate(['presets']) && validPresets();
      }

      // Server-only collections.
      // Append-only audit log (FND-18): written by functions, read through the audit-query callable.
      match /audit/{entryId} {
        allow read, write: if false;
      }
      // Trust balance snapshots (BILL-11, ADR-035): copied from the firm's trust records, never a
      // ledger. Only billing roles read them; `trust-recordSnapshot` writes and audits each change.
      match /trustSnapshots/{matterId} {
        allow read: if can(orgId, 'billing.view');
      }
      match /metrics/{metricId} {
        allow read: if can(orgId, 'billing.view');
      }
      match /migrations/{runId} {
        allow read: if can(orgId, 'org.settings') && isActiveMember(orgId);
      }
      match /integrations/{integrationId} {
        allow read, write: if false;
      }
      // Daily digest records (FND-20), `digest-{uid}-{date}`: written by notifications-digest so a
      // person gets one a day; Firestore TTL deletes them after 30 days.
      match /digests/{digestId} {
        allow read, write: if false;
      }
      match /counters/{counterId} {
        allow read, write: if false;
      }
      // Matter number reservations (CORE-03), written with the matter by matters-createMatter.
      match /matterNumbers/{numberKey} {
        allow read, write: if false;
      }
      // Conflict check runs (CORE-02): written only by conflicts-run and conflicts-onPartyAdded,
      // read by whoever can run a check (paralegal and above; never readonly).
      match /conflictChecks/{checkId} {
        allow read: if can(orgId, 'conflict.run');
      }
    }

    // ---------- collection groups ----------
    // Cross-matter queries ("my tasks", "deadlines this week", timesheets, a contact's matters).
    // Tasks (CORE-08, ADR-026): this rule also matches single task reads, and a group read can't
    // check each task's matter, so through the group a member reads the tasks assigned to them
    // (personal tasks, `matterId: null`, are always assigned to their owner), and only roles that
    // see every matter (privileged.view) read other matter tasks.
    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg())
        && (resource.data.assigneeUid == uid()
          || resource.data.get('matterId', null) != null && canViewPrivileged(claimOrg()));
    }
    // Deadlines across matters (CORE-10: the Deadlines screen, Today). A group query can't check
    // each deadline's matter, so it reads the copy of the matter's flag each deadline carries
    // (CORE-10b): roles without privileged.view must query `privileged == false`. This rule also
    // matches single reads, where the path rule checks the matter itself.
    match /{path=**}/deadlines/{deadlineId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg())
        && visible(claimOrg(), resource.data);
    }
    // Pending deadline changes across matters (CORE-10: "changes waiting on me"), likewise.
    match /{path=**}/deadlineChanges/{changeId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg())
        && visible(claimOrg(), resource.data);
    }
    // Time entries across matters (BILL-01, as tasks in ADR-026): a group query can't check each
    // entry's matter, so my own entries, or everyone's with privileged.view.
    match /{path=**}/timeEntries/{entryId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg())
        && (resource.data.uid == uid() || canViewPrivileged(claimOrg()));
    }
    // Disbursements across matters (BILL-04, for WIP): like time entries, a group query can't check
    // each one's matter, so only roles with privileged.view read them through the group.
    match /{path=**}/disbursements/{disbursementId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && canViewPrivileged(claimOrg());
    }
    // ⌘K document search (CORE-15, ADR-033): a group query can't `get()` each document's matter, and
    // a document on a matter marked privileged later may not be privileged itself, so only roles
    // that see every matter (privileged.view) read documents through the group. Other roles search
    // the open matter's documents at its path, where the matter is checked.
    match /{path=**}/documents/{documentId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && canViewPrivileged(claimOrg());
    }
    // "The matters this contact is on" (CORE-01): parties across matters, by orgId and contactId.
    match /{path=**}/parties/{partyId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg());
    }

    // ---------- generated from libs/domain ----------
    // <generated:rules-sync> do not edit: `pnpm materia-scripts rules-sync` writes this from libs/domain.
    // Roles allowed each action (PERMISSIONS).
    function perm(action) {
      return {
        'matter.view': ['owner', 'admin', 'lawyer', 'paralegal', 'readonly'],
        'matter.create': ['owner', 'admin', 'lawyer', 'paralegal'],
        'matter.edit': ['owner', 'admin', 'lawyer', 'paralegal'],
        'matter.delete': ['owner', 'admin', 'lawyer'],
        'matter.close': ['owner', 'admin', 'lawyer'],
        'matter.status': ['owner', 'admin', 'lawyer'],
        'matter.restore': ['owner', 'admin'],
        'matter.legalHold': ['owner', 'admin'],
        'matter.destroy': ['owner', 'admin'],
        'matter.renumber': ['owner', 'admin', 'lawyer'],
        'matter.fee': ['owner', 'admin', 'lawyer'],
        'contact.edit': ['owner', 'admin', 'lawyer', 'paralegal'],
        'contact.delete': ['owner', 'admin', 'lawyer'],
        'contact.merge': ['owner', 'admin'],
        'conflict.run': ['owner', 'admin', 'lawyer', 'paralegal'],
        'conflict.determine': ['owner', 'admin', 'lawyer'],
        'privileged.view': ['owner', 'admin', 'lawyer'],
        'document.upload': ['owner', 'admin', 'lawyer', 'paralegal'],
        'document.delete': ['owner', 'admin', 'lawyer'],
        'task.edit': ['owner', 'admin', 'lawyer', 'paralegal'],
        'note.write': ['owner', 'admin', 'lawyer', 'paralegal'],
        'deadline.override': ['owner', 'admin', 'lawyer'],
        'time.record': ['owner', 'admin', 'lawyer', 'paralegal'],
        'time.approve': ['owner', 'admin', 'lawyer'],
        'billing.view': ['owner', 'admin', 'lawyer'],
        'billing.issue': ['owner', 'admin', 'lawyer'],
        'billing.void': ['owner', 'admin'],
        'trust.record': ['owner', 'admin', 'lawyer'],
        'clerk.use': ['owner', 'admin', 'lawyer', 'paralegal'],
        'clerk.configure': ['owner', 'admin'],
        'members.manage': ['owner', 'admin'],
        'org.settings': ['owner', 'admin'],
        'org.delete': ['owner'],
        'audit.view': ['owner', 'admin'],
        'export.run': ['owner', 'admin'],
        'export.includePrivileged': ['owner', 'admin'],
        'safeCustody.edit': ['owner', 'admin', 'lawyer', 'paralegal'],
        'safeCustody.release': ['owner', 'admin', 'lawyer']
      }[action];
    }
    // Client-writable fields per entity (each entity's update schema keys).
    function fieldsActivity() { return ['kind', 'summary', 'actorUid', 'at', 'refs']; }
    function fieldsAsset() { return ['class', 'description', 'institution', 'valueAtDeathCents', 'valuationSource', 'valuedOn', 'jointlyHeld', 'jointHolding', 'shareBps', 'passesOutsideEstate', 'status', 'realisedCents', 'originalCurrency', 'originalAmount', 'documentIds', 'notes']; }
    function fieldsAuditEntry() { return []; }
    function fieldsCalendar() { return ['jurisdiction', 'year', 'calendarId', 'kind', 'holidays', 'closures', 'source', 'verified']; }
    function fieldsChecklistTemplate() { return ['name', 'items', 'priority', 'dueInDays']; }
    function fieldsChronologyEntry() { return ['date', 'datePrecision', 'title', 'detail', 'sources', 'disputed', 'issueIds']; }
    function fieldsChunk() { return ['orgId', 'matterId', 'text', 'page', 'docVersion', 'ordinal', 'privileged', 'ocr', 'embedding']; }
    function fieldsClerkDraft() { return ['bodyMd', 'provenance', 'stopRequested']; }
    function fieldsClerkMessage() { return ['stopRequested']; }
    function fieldsClerkThread() { return ['title', 'shared']; }
    function fieldsConflictCheck() { return []; }
    function fieldsContact() { return ['kind', 'givenNames', 'familyName', 'preferredName', 'dateOfBirth', 'dateOfDeath', 'orgName', 'abn', 'emails', 'phones', 'addresses', 'tags', 'isReferrer', 'referrerMeta', 'notes']; }
    function fieldsCounter() { return []; }
    function fieldsCourtBook() { return ['title', 'tabs', 'status']; }
    function fieldsCourtEvent() { return ['proceedingId', 'kind', 'date', 'time', 'location', 'outcome', 'ordersDocumentId']; }
    function fieldsCourtOrder() { return ['courtEventId', 'orderNo', 'text', 'requiresAction', 'dueDate', 'deadlineId', 'responsiblePartyRole', 'status']; }
    function fieldsCreditNote() { return []; }
    function fieldsDeadline() { return ['title', 'dueDate', 'dueTime', 'kind', 'critical', 'assigneeUid', 'reminders', 'ackBy', 'ackAt']; }
    function fieldsDeadlineChange() { return []; }
    function fieldsDestructionCertificate() { return []; }
    function fieldsDestructionRequest() { return []; }
    function fieldsDevice() { return ['token', 'platform', 'lastSeenAt']; }
    function fieldsDisbursement() { return ['date', 'description', 'payee', 'category', 'presetId', 'amountExGstCents', 'gstCents', 'amountIncGstCents', 'gstTreatment', 'receiptDocumentId']; }
    function fieldsDisbursementPresetsDoc() { return ['presets']; }
    function fieldsDistribution() { return ['beneficiaryPartyId', 'kind', 'amountCents', 'assetId', 'share', 'status', 'paidOn', 'paymentReference', 'notes', 'needsValueReview']; }
    function fieldsDocTemplate() { return []; }
    function fieldsDocumentHash() { return []; }
    function fieldsEvidence() { return ['documentId', 'witnessPartyId', 'issueIds', 'supports', 'strength', 'admissibilityNote']; }
    function fieldsFactCitation() { return []; }
    function fieldsIntakeDraft() { return ['orgId', 'kind', 'step', 'stateJson', 'expireAt']; }
    function fieldsIntegration() { return []; }
    function fieldsInvite() { return ['role']; }
    function fieldsInvoice() { return []; }
    function fieldsInvoiceReminder() { return []; }
    function fieldsIssue() { return ['title', 'elements', 'ourPosition', 'internalAssessment']; }
    function fieldsJob() { return []; }
    function fieldsLetterheadDoc() { return []; }
    function fieldsLiability() { return ['class', 'creditor', 'reference', 'amountCents', 'status', 'notes']; }
    function fieldsMatter() { return ['title', 'responsibleUid', 'teamUids', 'labels', 'priority', 'externalRef', 'externalUrl', 'estate', 'deceased', 'facts', 'privileged', 'referrerContactId', 'referralSource', 'boardOrder']; }
    function fieldsMatterDocument() { return ['name', 'category', 'privileged', 'accessRestricted', 'tags', 'notes']; }
    function fieldsMatterEvent() { return []; }
    function fieldsMatterNumber() { return []; }
    function fieldsMatterTemplate() { return []; }
    function fieldsMatterTemplateVersion() { return []; }
    function fieldsMember() { return ['displayName', 'initials', 'title', 'admissionNo', 'defaultRateCents', 'rates', 'colour', 'budgets', 'supervisorUid']; }
    function fieldsMetrics() { return ['period', 'values', 'debtors']; }
    function fieldsMigrationRun() { return []; }
    function fieldsNote() { return ['pinned']; }
    function fieldsNoteRevision() { return []; }
    function fieldsNotification() { return ['readAt', 'hiddenAt']; }
    function fieldsOffer() { return ['kind', 'by', 'madeOn', 'expiresOn', 'amountCents', 'termsMd', 'status', 'deadlineId', 'privileged']; }
    function fieldsOrg() { return ['acn', 'practiceType', 'matterNumberFormat', 'matterTypeCodes', 'feeDefaults', 'fy', 'destructionKeepsTitle', 'plan', 'settings', 'termsAcceptedVersion']; }
    function fieldsParty() { return ['share', 'notes']; }
    function fieldsPersonalTask() { return ['title', 'status', 'priority', 'assigneeUid', 'dueDate', 'checklist', 'order', 'group']; }
    function fieldsProceeding() { return ['court', 'list', 'location', 'fileNumber', 'judicialOfficer', 'stage', 'filedOn', 'ourRole']; }
    function fieldsRecentMatter() { return ['orgId', 'kind', 'matterId', 'entityId', 'expireAt']; }
    function fieldsRuleSetVersion() { return ['ruleSetId', 'version', 'jurisdiction', 'published', 'practitionerReviewed', 'flag', 'disclaimer', 'rules']; }
    function fieldsSafeCustody() { return []; }
    function fieldsSavedView() { return ['orgId', 'list', 'name', 'filters', 'sort', 'groupBy']; }
    function fieldsSignIn() { return []; }
    function fieldsSubpoena() { return ['issuedTo', 'direction', 'issuedOn', 'returnDate', 'status', 'accessOrderMade', 'materialDocumentIds']; }
    function fieldsSuggestion() { return []; }
    function fieldsTask() { return ['title', 'status', 'priority', 'assigneeUid', 'dueDate', 'checklist', 'order', 'group']; }
    function fieldsTaskGroupTemplate() { return ['name', 'tasks']; }
    function fieldsTimeEntry() { return ['date', 'minutes', 'units', 'rateCents', 'amountCents', 'narrative', 'billable', 'taskId']; }
    function fieldsTimer() { return ['taskId', 'startedAt', 'accumulatedMs', 'running', 'narrativeDraft', 'lastHeartbeatAt', 'clientStarted', 'needsReview', 'forgottenSeenAt']; }
    function fieldsTrustSnapshot() { return []; }
    function fieldsUser() { return ['displayName', 'firstName', 'lastName', 'prefs', 'avatarUrl']; }
    // </generated:rules-sync>

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
