rules_version = '2';

// Materia Firestore rules (FND-14). Default deny; tenancy from custom claims {orgId, role}
// (ADR-005); clients read directly and update whitelisted fields directly (ADR-006). Creates go
// through callables (Admin SDK, which bypasses these rules) and hard deletes are never allowed.
//
// Extending: add a `match` block next to its siblings, gate it with `can(orgId, '<action>')` from
// the PERMISSIONS matrix, and allow updates with `clientUpdate(fields<Entity>())`. The role lists
// and field whitelists at the bottom are generated from libs/domain
// (`pnpm materia-scripts rules-sync`), and the rules tests fail if a collection has no tests.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity and tenancy ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function claimOrg() {
      return request.auth.token.orgId;
    }
    function claimRole() {
      return request.auth.token.role;
    }
    // The claim names the org, and the member document must still be active: a suspended or removed
    // member loses access on their next request, without waiting for their token to refresh (FND-17,
    // ADR-021). Rules cache the get() within a request, so it costs one read per request.
    function inOrg(orgId) {
      return isSignedIn() && claimOrg() == orgId
        && get(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid())).data.status == 'active';
    }
    function hasRole(orgId, roles) {
      return inOrg(orgId) && claimRole() in roles;
    }
    function can(orgId, action) {
      return hasRole(orgId, perm(action));
    }
    // Kept at sensitive paths for clarity; inOrg() already checks the member document.
    function isActiveMember(orgId) {
      return inOrg(orgId);
    }
    function canViewPrivileged(orgId) {
      return can(orgId, 'privileged.view') && isActiveMember(orgId);
    }
    // Privileged documents are readable only by roles with privileged.view (never readonly).
    // No get() default here: in a list query, `data.get(field, default)` on a field the query does
    // not constrain evaluates to the default, which would let any query through. Comparing the
    // field itself makes a query prove it (where('privileged', '==', false)). Every entity with a
    // privileged flag stores it (the schemas default it to false).
    function visible(orgId, data) {
      return data.privileged == false || canViewPrivileged(orgId);
    }

    // ---------- writes ----------
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function unchanged(fields) {
      return !changedKeys().hasAny(fields);
    }
    function onlyChanged(fields) {
      return changedKeys().hasOnly(fields);
    }
    function validMeta() {
      return request.resource.data.updatedBy == uid() && request.resource.data.updatedAt == request.time;
    }
    // An update that touches only whitelisted fields (plus updatedAt/updatedBy) and stamps meta.
    function clientUpdate(fields) {
      return onlyChanged(fields.concat(['updatedAt', 'updatedBy'])) && validMeta();
    }
    // Soft delete (or restore): only the delete fields and meta change.
    function softDelete() {
      return onlyChanged(['deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && validMeta()
        && (
          (request.resource.data.deletedAt == request.time && request.resource.data.deletedBy == uid())
          || (request.resource.data.get('deletedAt', null) == null && request.resource.data.get('deletedBy', null) == null)
        );
    }
    // Changing the privileged flag needs privileged.view.
    function privilegedFlagOk(orgId) {
      return unchanged(['privileged']) || canViewPrivileged(orgId);
    }
    // Standard rule for org records: update whitelisted fields, or soft delete.
    function editable(orgId, action, fields) {
      return can(orgId, action) && (clientUpdate(fields) || softDelete());
    }

    // ---------- global reference data (read-only for clients) ----------
    match /ruleSets/{ruleSetId} {
      allow read: if isSignedIn();
      match /versions/{version} {
        allow read: if isSignedIn();
      }
    }
    match /calendars/{calendarId} {
      allow read: if isSignedIn();
    }
    match /systemTemplates/{templateId} {
      allow read: if isSignedIn();
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && uid() == userId && clientUpdate(fieldsUser());

      // Server-only: MFA recovery code hashes and sign-in stamps (FND-16). Not even the owner reads them.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // ---------- organisations ----------
    match /orgs/{orgId} {
      allow read: if inOrg(orgId);
      allow update: if can(orgId, 'org.settings') && isActiveMember(orgId) && clientUpdate(fieldsOrg());

      match /members/{memberUid} {
        allow read: if inOrg(orgId);
        allow update: if can(orgId, 'members.manage') && isActiveMember(orgId) && clientUpdate(fieldsMember());

        // Personal tasks: the member's own.
        match /tasks/{taskId} {
          allow read: if inOrg(orgId) && uid() == memberUid;
          allow update: if inOrg(orgId) && uid() == memberUid && (clientUpdate(fieldsPersonalTask()) || softDelete());
        }
      }

      match /invites/{inviteId} {
        allow read: if can(orgId, 'members.manage') && isActiveMember(orgId);
        allow update: if can(orgId, 'members.manage') && isActiveMember(orgId) && clientUpdate(fieldsInvite());
      }

      match /contacts/{contactId} {
        allow read: if inOrg(orgId);
        allow update: if can(orgId, 'matter.edit') && clientUpdate(fieldsContact())
          || can(orgId, 'matter.delete') && softDelete();
      }

      match /matters/{matterId} {
        allow read: if inOrg(orgId) && visible(orgId, resource.data);
        allow update: if visible(orgId, resource.data) && privilegedFlagOk(orgId)
          && (can(orgId, 'matter.edit') && clientUpdate(fieldsMatter()) || can(orgId, 'matter.delete') && softDelete());

        // Server-written feed.
        match /activity/{activityId} {
          allow read: if inOrg(orgId);
        }

        match /tasks/{taskId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'task.edit', fieldsTask());
        }

        match /deadlines/{deadlineId} {
          allow read: if inOrg(orgId);
          // Overriding a computed date needs deadline.override.
          allow update: if editable(orgId, 'task.edit', fieldsDeadline())
            && (unchanged(['override']) || can(orgId, 'deadline.override'));
        }

        match /timeEntries/{entryId} {
          allow read: if inOrg(orgId);
          // Your own entries, or anyone's with time.approve. Billed entries are immutable (invariant 5).
          allow update: if (can(orgId, 'time.approve') || can(orgId, 'time.record') && resource.data.uid == uid())
            && resource.data.status != 'billed'
            && unchanged(['uid'])
            && (clientUpdate(fieldsTimeEntry()) || softDelete());
        }

        match /documents/{documentId} {
          allow read: if inOrg(orgId) && visible(orgId, resource.data);
          allow update: if visible(orgId, resource.data) && privilegedFlagOk(orgId)
            && (can(orgId, 'document.upload') && clientUpdate(fieldsMatterDocument())
              || can(orgId, 'document.delete') && softDelete());

          // Embeddings for retrieval: server only, never read by clients.
          match /chunks/{chunkId} {
            allow read, write: if false;
          }
        }

        match /notes/{noteId} {
          allow read: if inOrg(orgId) && visible(orgId, resource.data);
          allow update: if visible(orgId, resource.data) && privilegedFlagOk(orgId)
            && editable(orgId, 'note.write', fieldsNote());
        }

        match /offers/{offerId} {
          allow read: if inOrg(orgId) && visible(orgId, resource.data);
          allow update: if visible(orgId, resource.data) && privilegedFlagOk(orgId)
            && editable(orgId, 'matter.edit', fieldsOffer());
        }

        // Clerk suggestions: the only client transition is proposed → dismissed.
        match /suggestions/{suggestionId} {
          allow read: if inOrg(orgId);
          allow update: if can(orgId, 'clerk.use')
            && resource.data.status == 'proposed'
            && request.resource.data.status == 'dismissed'
            && clientUpdate(fieldsSuggestion());
        }

        match /parties/{partyId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsParty());
        }
        match /events/{eventId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsMatterEvent());
        }
        match /disbursements/{disbursementId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'time.record', fieldsDisbursement());
        }
        match /assets/{assetId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsAsset());
        }
        match /liabilities/{liabilityId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsLiability());
        }
        match /distributions/{distributionId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsDistribution());
        }
        match /proceedings/{proceedingId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsProceeding());
        }
        match /courtEvents/{courtEventId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsCourtEvent());
        }
        match /orders/{orderId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsCourtOrder());
        }
        match /chronology/{entryId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsChronologyEntry());
        }
        match /issues/{issueId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsIssue());
        }
        match /evidence/{evidenceId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsEvidence());
        }
        match /subpoenas/{subpoenaId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsSubpoena());
        }
        match /courtBooks/{courtBookId} {
          allow read: if inOrg(orgId);
          allow update: if editable(orgId, 'matter.edit', fieldsCourtBook());
        }
      }

      match /clerkThreads/{threadId} {
        function thread() {
          return get(/databases/$(database)/documents/orgs/$(orgId)/clerkThreads/$(threadId)).data;
        }
        allow read: if can(orgId, 'clerk.use') && (resource.data.ownerUid == uid() || resource.data.shared == true);
        allow update: if can(orgId, 'clerk.use') && resource.data.ownerUid == uid() && unchanged(['ownerUid'])
          && (clientUpdate(fieldsClerkThread()) || softDelete());

        match /messages/{messageId} {
          allow read: if can(orgId, 'clerk.use') && (thread().ownerUid == uid() || thread().shared == true);
          // The thread owner can ask a running reply to stop.
          allow update: if can(orgId, 'clerk.use') && thread().ownerUid == uid() && clientUpdate(fieldsClerkMessage());
        }
      }

      match /invoices/{invoiceId} {
        allow read: if can(orgId, 'billing.view');
        // Draft invoices only; issuing and voiding are callables.
        allow update: if can(orgId, 'billing.issue') && resource.data.status == 'draft' && clientUpdate(fieldsInvoice());
      }
      match /creditNotes/{creditNoteId} {
        allow read: if can(orgId, 'billing.view');
      }

      match /templates/{templateId} {
        allow read: if inOrg(orgId);
        allow update: if can(orgId, 'org.settings') && clientUpdate(fieldsMatterTemplate());
      }
      match /docTemplates/{templateId} {
        allow read: if inOrg(orgId);
        allow update: if editable(orgId, 'org.settings', fieldsDocTemplate());
      }

      match /safeCustody/{packetId} {
        allow read: if inOrg(orgId);
        allow update: if editable(orgId, 'matter.edit', fieldsSafeCustody());
      }

      // Each member reads and marks read only their own notifications.
      match /notifications/{notificationId} {
        allow read: if inOrg(orgId) && resource.data.recipientUid == uid();
        allow update: if inOrg(orgId) && resource.data.recipientUid == uid() && clientUpdate(fieldsNotification());
      }

      // Background jobs (FND-24): written by functions and the Cloud Run job; the member who
      // started a job watches its progress.
      match /jobs/{jobId} {
        allow read: if inOrg(orgId) && resource.data.createdBy == uid();
      }

      // Server-only collections.
      // Append-only audit log (FND-18): written by functions, read through the audit-query callable.
      match /audit/{entryId} {
        allow read, write: if false;
      }
      match /metrics/{metricId} {
        allow read: if can(orgId, 'billing.view');
      }
      match /migrations/{runId} {
        allow read: if can(orgId, 'org.settings') && isActiveMember(orgId);
      }
      match /integrations/{integrationId} {
        allow read, write: if false;
      }
      match /counters/{counterId} {
        allow read, write: if false;
      }
    }

    // ---------- collection groups ----------
    // Cross-matter queries ("my tasks", "deadlines this week", timesheets). Personal tasks share the
    // `tasks` group name, so reading one through the group needs to be its assignee.
    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg())
        && (resource.data.get('matterId', null) != null || resource.data.assigneeUid == uid());
    }
    match /{path=**}/deadlines/{deadlineId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg());
    }
    match /{path=**}/timeEntries/{entryId} {
      allow read: if isSignedIn() && resource.data.orgId == claimOrg() && inOrg(claimOrg());
    }

    // ---------- generated from libs/domain ----------
    // <generated:rules-sync> do not edit: `pnpm materia-scripts rules-sync` writes this from libs/domain.
    // Roles allowed each action (PERMISSIONS).
    function perm(action) {
      return {
        'matter.view': ['owner', 'admin', 'lawyer', 'paralegal', 'readonly'],
        'matter.create': ['owner', 'admin', 'lawyer', 'paralegal'],
        'matter.edit': ['owner', 'admin', 'lawyer', 'paralegal'],
        'matter.delete': ['owner', 'admin', 'lawyer'],
        'matter.close': ['owner', 'admin', 'lawyer'],
        'privileged.view': ['owner', 'admin', 'lawyer'],
        'document.upload': ['owner', 'admin', 'lawyer', 'paralegal'],
        'document.delete': ['owner', 'admin', 'lawyer'],
        'task.edit': ['owner', 'admin', 'lawyer', 'paralegal'],
        'note.write': ['owner', 'admin', 'lawyer', 'paralegal'],
        'deadline.override': ['owner', 'admin', 'lawyer'],
        'time.record': ['owner', 'admin', 'lawyer', 'paralegal'],
        'time.approve': ['owner', 'admin', 'lawyer'],
        'billing.view': ['owner', 'admin', 'lawyer'],
        'billing.issue': ['owner', 'admin'],
        'billing.void': ['owner', 'admin'],
        'clerk.use': ['owner', 'admin', 'lawyer', 'paralegal'],
        'clerk.configure': ['owner', 'admin'],
        'members.manage': ['owner', 'admin'],
        'org.settings': ['owner', 'admin'],
        'org.delete': ['owner'],
        'audit.view': ['owner', 'admin'],
        'export.run': ['owner', 'admin'],
        'export.includePrivileged': ['owner', 'admin']
      }[action];
    }
    // Client-writable fields per entity (each entity's update schema keys).
    function fieldsActivity() { return ['kind', 'summary', 'actorUid', 'at', 'refs']; }
    function fieldsAsset() { return ['class', 'description', 'valueAtDeathCents', 'valuationSource', 'jointlyHeld', 'passesOutsideEstate', 'status', 'realisedCents']; }
    function fieldsAuditEntry() { return []; }
    function fieldsCalendar() { return ['jurisdiction', 'year', 'calendarId', 'kind', 'holidays', 'closures', 'source', 'verified']; }
    function fieldsChronologyEntry() { return ['date', 'datePrecision', 'title', 'detail', 'sources', 'disputed', 'issueIds']; }
    function fieldsChunk() { return ['orgId', 'matterId', 'text', 'page', 'embedding']; }
    function fieldsClerkMessage() { return ['stopRequested']; }
    function fieldsClerkThread() { return ['title', 'ownerUid', 'matterId', 'shared']; }
    function fieldsContact() { return ['kind', 'givenNames', 'familyName', 'preferredName', 'dateOfBirth', 'dateOfDeath', 'orgName', 'abn', 'emails', 'phones', 'addresses', 'tags', 'isReferrer', 'referrerMeta', 'notes']; }
    function fieldsCourtBook() { return ['title', 'tabs', 'status']; }
    function fieldsCourtEvent() { return ['proceedingId', 'kind', 'date', 'time', 'location', 'outcome', 'ordersDocumentId']; }
    function fieldsCourtOrder() { return ['courtEventId', 'orderNo', 'text', 'requiresAction', 'dueDate', 'deadlineId', 'responsiblePartyRole', 'status']; }
    function fieldsCreditNote() { return []; }
    function fieldsDeadline() { return ['title', 'dueDate', 'dueTime', 'kind', 'critical', 'status', 'blockedReason', 'override', 'reminders', 'assigneeUid', 'ackBy', 'ackAt']; }
    function fieldsDisbursement() { return ['date', 'description', 'amountExGstCents', 'gstTreatment', 'payee', 'receiptDocumentId', 'status']; }
    function fieldsDistribution() { return ['beneficiaryPartyId', 'kind', 'amountCents', 'assetId', 'status', 'paidOn']; }
    function fieldsDocTemplate() { return ['name', 'storagePath', 'mergeFields', 'matterTypes', 'active']; }
    function fieldsEvidence() { return ['documentId', 'witnessPartyId', 'issueIds', 'supports', 'strength', 'admissibilityNote']; }
    function fieldsIntegration() { return []; }
    function fieldsInvite() { return ['role']; }
    function fieldsInvoice() { return ['lines', 'dueDate']; }
    function fieldsIssue() { return ['title', 'elements', 'ourPosition', 'internalAssessment']; }
    function fieldsJob() { return []; }
    function fieldsLiability() { return ['class', 'creditor', 'amountCents', 'status']; }
    function fieldsMatter() { return ['title', 'type', 'status', 'stageId', 'templateId', 'templateVersion', 'jurisdiction', 'responsibleUid', 'teamUids', 'clientContactIds', 'deceased', 'testator', 'referrerContactId', 'referralSource', 'fee', 'costsDisclosure', 'conflictCheck', 'estate', 'dispute', 'privileged', 'priority', 'externalRef', 'boardOrder', 'labels', 'relatedMatterIds', 'closeReason', 'destroyAfter']; }
    function fieldsMatterDocument() { return ['name', 'category', 'privileged', 'accessRestricted']; }
    function fieldsMatterEvent() { return ['kind', 'date', 'time', 'label', 'meta', 'sourceDocumentId']; }
    function fieldsMatterTemplate() { return ['name', 'matterType', 'version', 'stages', 'tasks', 'deadlineRuleIds', 'published', 'source']; }
    function fieldsMember() { return ['displayName', 'initials', 'title', 'admissionNo', 'defaultRateCents', 'rates', 'colour', 'budgets', 'supervisorUid']; }
    function fieldsMetrics() { return ['period', 'values']; }
    function fieldsMigrationRun() { return []; }
    function fieldsNote() { return ['bodyMd', 'pinned', 'privileged', 'source']; }
    function fieldsNotification() { return ['readAt']; }
    function fieldsOffer() { return ['kind', 'by', 'madeOn', 'expiresOn', 'amountCents', 'termsMd', 'status', 'deadlineId', 'privileged']; }
    function fieldsOrg() { return ['name', 'abn', 'acn', 'practiceType', 'jurisdictions', 'primaryJurisdiction', 'timezone', 'holidayLocality', 'billing', 'matterNumberFormat', 'fy', 'retentionYears', 'plan', 'security', 'settings', 'termsAcceptedVersion']; }
    function fieldsParty() { return ['contactId', 'role', 'share', 'notes', 'addedFrom']; }
    function fieldsPersonalTask() { return ['title', 'descriptionMd', 'status', 'priority', 'assigneeUid', 'dueDate', 'deadlineId', 'group', 'checklist', 'order', 'source']; }
    function fieldsProceeding() { return ['court', 'list', 'location', 'fileNumber', 'judicialOfficer', 'stage', 'filedOn', 'ourRole']; }
    function fieldsRuleSetVersion() { return ['ruleSetId', 'version', 'jurisdiction', 'published', 'practitionerReviewed', 'rules']; }
    function fieldsSafeCustody() { return ['testatorContactId', 'documentIds', 'packetNo', 'location', 'receivedOn']; }
    function fieldsSubpoena() { return ['issuedTo', 'direction', 'issuedOn', 'returnDate', 'status', 'accessOrderMade', 'materialDocumentIds']; }
    function fieldsSuggestion() { return ['status']; }
    function fieldsTask() { return ['title', 'descriptionMd', 'status', 'priority', 'assigneeUid', 'dueDate', 'deadlineId', 'group', 'checklist', 'order', 'source']; }
    function fieldsTimeEntry() { return ['uid', 'date', 'minutes', 'rateCents', 'narrative', 'billable', 'status', 'source', 'taskId']; }
    function fieldsUser() { return ['displayName', 'firstName', 'lastName', 'prefs']; }
    // </generated:rules-sync>

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
