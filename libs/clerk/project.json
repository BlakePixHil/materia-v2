{
  "name": "clerk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/clerk/src",
  "projectType": "library",
  "tags": ["type:util", "scope:functions"],
  "// targets": "to see all targets run: nx show project clerk --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p libs/clerk/tsconfig.lib.json && tsc --noEmit -p libs/clerk/tsconfig.spec.json"
      }
    },
    "eval": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig apps/functions/tsconfig.app.json apps/functions/src/clerk/evals/cli.ts",
        "forwardAllArgs": true
      }
    }
  }
}
