{
  "name": "data-access",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/data-access/src",
  "prefix": "mt",
  "projectType": "library",
  "tags": ["type:data-access", "scope:web"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p libs/data-access/tsconfig.lib.json && tsc --noEmit -p libs/data-access/tsconfig.spec.json"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "firebase emulators:exec --only firestore --project demo-materia --config firebase.json \"vitest run --config libs/data-access/vitest.integration.config.mts\"",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
