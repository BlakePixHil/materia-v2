      "id": "au.cgt.main_residence",
      "title": "Main residence CGT exemption window (2 years from death)",
      "citation": "Income Tax Assessment Act 1997 (Cth) s 118-195",
      "explain": "A deceased's main residence disposed of within 2 years of death can be fully exempt from CGT (the Commissioner can extend).",
      "appliesTo": {
        "matterTypes": ["probate", "loa", "admin"],
        "jurisdictions": ["VIC"]
      },
      "anchor": {
        "event": "date_of_death"
      },
      "offset": {
        "years": 2
      },
