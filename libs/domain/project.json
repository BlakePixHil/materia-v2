{
  "name": "domain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/src",
  "projectType": "library",
  "tags": ["type:domain", "scope:shared"],
  "// targets": "to see all targets run: nx show project domain --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p libs/domain/tsconfig.lib.json && tsc --noEmit -p libs/domain/tsconfig.spec.json"
      }
    }
  }
}
