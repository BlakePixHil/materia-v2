        "fromStageEntry": 5
      },
      "priority": "high",
      "checklist": [
        "Estimate of total legal costs",
        "Rights to negotiate and to receive itemised bills",
        "Client signed and returned the agreement"
      ]
    },
    {
      "key": "search_for_grant",
      "title": "Search for a grant or a pending application",
      "stageId": "will_grant_search",
      "assignTo": "role:paralegal",
      "due": {
        "fromStageEntry": 1
      },
      "priority": "urgent"
