      "title": "Brief counsel for the hearing",
      "stageId": "hearing",
      "assignTo": "responsible",
      "due": {
        "fromStageEntry": 14
      },
      "priority": "high"
    },
    {
      "key": "prepare_court_book",
      "title": "Prepare the court book",
      "stageId": "hearing",
      "assignTo": "role:paralegal",
      "due": {
        "fromStageEntry": 21
      },
      "priority": "high"
