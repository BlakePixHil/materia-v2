        "tasksDone": ["take_instructions"]
      }
    },
    {
      "id": "caveat_lodged",
      "name": "Caveat lodged",
      "order": 30,
      "criteria": "Caveat against the grant lodged",
      "entryRequires": {
        "events": ["caveat_lodged"],
        "tasksDone": ["search_for_grant"]
      }
    },
    {
      "id": "proceedings_filed",
      "name": "Proceedings filed",
      "order": 40,
      "criteria": "Proceedings filed in the Supreme Court",
      "entryRequires": {
        "facts": ["courtFileNo"]
      }
    },
    {
      "id": "directions",
      "name": "Directions",
      "order": 50,
      "criteria": "First directions hearing held",
      "entryRequires": {
        "tasksDone": ["serve_proceedings"]
      }
    },
    {
      "id": "mediation",
      "name": "Mediation",
      "order": 60,
      "criteria": "Mediation held"
    },
    {
      "id": "hearing",
      "name": "Hearing",
      "order": 70,
      "criteria": "Matter heard"
    },
    {
      "id": "orders",
      "name": "Orders",
      "order": 80,
      "criteria": "Orders made or settlement signed",
