    {
      "key": "serve_proceedings",
      "title": "Serve the proceedings",
      "stageId": "proceedings_filed",
      "assignTo": "role:paralegal",
      "due": {
        "fromStageEntry": 7
      },
      "priority": "high"
    },
    {
      "key": "prepare_for_directions",
      "title": "Prepare for the directions hearing",
      "stageId": "directions",
      "assignTo": "responsible",
      "due": {
        "fromStageEntry": 7
      },
      "priority": "medium"
    },
    {
