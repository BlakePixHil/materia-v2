{
  "id": "system-fp",
  "source": "system",
  "version": 1,
  "published": true,
  "publishedAt": "2026-10-04",
  "matterType": "fp",
  "name": "Family provision claim (plaintiff, VIC)",
  "stages": [
    {
      "id": "instructions",
      "name": "Instructions",
      "order": 10,
      "criteria": "Instructions taken and costs disclosure sent"
    },
    {
