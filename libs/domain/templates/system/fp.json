      "due": {
        "fromStageEntry": 2
      },
      "priority": "high",
      "checklist": [
        "Relationship to the deceased",
        "Financial position and needs",
        "Will and estate as known",
        "Other potential claimants"
      ]
    },
    {
      "key": "send_costs_disclosure",
      "title": "Send the costs disclosure and costs agreement",
      "stageId": "instructions",
      "assignTo": "responsible",
      "due": {
        "fromStageEntry": 5
      },
      "priority": "high",
      "checklist": [
        "Estimate of total legal costs",
        "Rights to negotiate and to receive itemised bills",
        "Client signed and returned the agreement"
