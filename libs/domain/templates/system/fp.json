      "name": "Limitation check",
      "order": 20,
      "criteria": "Grant searched and the limitation date confirmed",
      "entryRequires": {
        "tasksDone": ["take_instructions"]
      }
    },
    {
      "id": "letter_of_demand",
      "name": "Letter of demand",
      "order": 30,
      "criteria": "Letter of demand sent to the executor’s solicitors",
      "entryRequires": {
        "tasksDone": ["search_for_grant"]
      }
    },
    {
      "id": "summons_filed",
      "name": "Summons filed",
      "order": 40,
      "criteria": "Originating process filed in the Supreme Court",
      "entryRequires": {
        "facts": ["courtFileNo"],
        "tasksDone": ["send_letter_of_demand"]
      }
    },
    {
      "id": "directions",
      "name": "Directions",
      "order": 50,
      "criteria": "First directions hearing held",
      "entryRequires": {
        "tasksDone": ["serve_summons"]
      }
    },
    {
      "id": "mediation",
      "name": "Mediation",
      "order": 60,
      "criteria": "Mediation held"
    },
    {
      "id": "hearing",
      "name": "Hearing",
      "order": 70,
      "criteria": "Matter heard"
    },
    {
      "id": "orders",
      "name": "Orders",
      "order": 80,
      "criteria": "Orders made or settlement signed",
      "entryRequires": {
        "events": ["order_made"]
      }
    },
    {
      "id": "closed",
      "name": "Closed",
      "order": 90,
      "criteria": "Orders complied with, costs settled and the file closed",
      "terminal": true
    }
