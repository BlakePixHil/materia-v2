{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["es2022"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "vitest.config.mts",
    "../../libs/domain/src/**/*.ts",
    "../../libs/test-utils/src/**/*.ts",
    "../../libs/deadlines/src/**/*.ts"
  ],
  "exclude": ["../../libs/**/*.spec.ts"]
}
